  <translations>
    <sentence id="00001" fixed="0">
      <text lang="Spanish">
        <![CDATA[  Pulsa una tecla para continuar... (%d)]]>
      </text>
      <text lang="English">
        <![CDATA[Press a key to continue... (%d)]]>
      </text>
      <text lang="French">
        <![CDATA[Appuyez sur une touche pour continuer... (%d)]]>
      </text>
      <text lang="German">
        <![CDATA[Drücken Sie eine Taste, um fortzufahren... (%d)]]>
      </text>
      <text lang="Chinese">
        <![CDATA[按任意键继续... (%d)]]>
      </text>
    </sentence>
    <sentence id="00002" fixed="0">
      <text lang="Spanish">
        <![CDATA[Tecla presionada: 0x%02X [%c]]]>
      </text>
      <text lang="English">
        <![CDATA[Key pressed: 0x%02X [%c]]]>
      </text>
      <text lang="French">
        <![CDATA[Touche enfoncée : 0x%02X [%c]]]>
      </text>
      <text lang="German">
        <![CDATA[Taste gedrückt: 0x%02X [%c]]]>
      </text>
      <text lang="Chinese">
        <![CDATA[按下按键：0x%02X [%c]]]>
      </text>
    </sentence>
  </translations>
</lng>
