    <sentence id="00103" fixed="0">
      <text lang="Spanish">
        <![CDATA[Ejecute exec en %d milisegundos (%.2f segundos).]]>
      </text>
      <text lang="English">
        <![CDATA[Run exec in %d milliseconds (%.2f seconds).]]>
      </text>
