      <element name="conn_body" type="form" class="flex-row" style="margin: 20,0,0,24; align-items: center;" width="328" height="200">
        <!-- Left column wide enough for badge + "Desconectado" at 22pt (was 220: text clipped on offline). -->
        <element name="conn-left" type="form" class="flex-col" style="flex-shrink: 0;" width="248" height="190">
          <element name="conn-status-row" type="form" class="flex-row" style="align-items: center;" width="248" height="72">
            <element name="conn-badge-slot" type="form" class="flex-row" style="flex-shrink: 0; background-color: 0,0,0,0; border-width: 0;" width="64" height="64">
              <element name="connection_icon_ok" type="image" width="64" height="64" visible="yes">icons/badge_ok.svg</element>
              <element name="connection_icon_ko" type="image" width="64" height="64" visible="no">icons/badge_ko.svg</element>
            </element>
            <element name="connection_status_text" type="text" class="value-ok" style="margin: 0,0,0,10; flex-shrink: 0;" sizefont="22">#[CONNECTION_STATUS]</element>
          </element>
          <element name="connection_quality"   type="text" class="label" style="margin: 14,0,0,0;" sizefont="17">#[CONNECTION_QUALITY]</element>
          <element name="connection_ip"        type="text" class="label" style="margin: 10,0,0,0;" sizefont="16">#[LOCAL_IP]</element>
          <element name="connection_public_ip" type="text" class="label" style="margin: 10,0,0,0;" sizefont="16">#[PUBLIC_IP]</element>
        </element>
        <element name="conn_row_spacer" type="form" style="flex-grow: 1; background-color: 0,0,0,0; border-width: 0;" width="0" height="0"></element>
        <element name="connection_net_icon" type="image" style="flex-shrink: 0;" width="72" height="72">icons/internet-net.svg</element>
      </element>
    </element>

