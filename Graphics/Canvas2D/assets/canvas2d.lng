  <translations>
    <sentence id="00001" fixed="0">
      <text lang="Spanish">
        <![CDATA[Érase una vez,]]>
      </text>
      <text lang="English">
        <![CDATA[Once upon a time,]]>
      </text>
      <text lang="French">
        <![CDATA[Il était une fois,]]>
      </text>
      <text lang="German">
        <![CDATA[Es war einmal,]]>
      </text>
      <text lang="Chinese">
        <![CDATA[曾几何时，]]>
      </text>
    </sentence>
    <sentence id="00002" fixed="0">
      <text lang="Spanish">
        <![CDATA[en un reino muy, muy lejano...]]>
      </text>
      <text lang="English">
        <![CDATA[in a kingdom far, far away... ]]>
      </text>
      <text lang="French">
        <![CDATA[dans un royaume lointain, très lointain...]]>
      </text>
      <text lang="German">
        <![CDATA[In einem weit, weit entfernten Königreich ...]]>
      </text>
      <text lang="Chinese">
        <![CDATA[在一个遥远的王国里……]]>
      </text>
    </sentence>
  </translations>
</lng>
