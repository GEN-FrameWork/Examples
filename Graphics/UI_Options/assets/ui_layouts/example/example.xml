<?xml version="1.0" encoding="UTF-8"?>
<!--
  GEN XML Gallery _ Manual T_cnico 1024x576.
  Top-level ypos = bottom edge (larger ypos = lower on screen).
  Nested child ypos = offset UP from parent bottom (larger = closer to parent top).
  Section titles/icons are declared AFTER their frames so they paint above FormBackdrop restores.

  Vertical rhythm:
    title _ frame top = 14px
    header icon = frame_left+2, text = frame_left+24, icon ypos = text ypos+6
    frame inner top/bottom pad _ 6_8px
    section gap (frame bottom _ next title) _ 16px
-->
